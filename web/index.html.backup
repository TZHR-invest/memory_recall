                            <p>没有找到与该人物相关的记忆</p>
                        </div>
                    `;
                } else {
                    container.innerHTML = data.results.map(memory => renderMemoryItem(memory)).join('');
                }

                resultsCard.style.display = 'block';
            } catch (error) {
                showToast('搜索失败：' + error.message, 'error');
            }
        }

        // Advanced Search (combine all filters)
        async function advancedSearch() {
            const keyword = document.getElementById('filter-keyword-adv').value.trim();
            
            if (!keyword) {
                showToast('请输入关键词进行筛选', 'error');
                return;
            }

            try {
                const data = await apiCall('/api/v1/memories/search', 'POST', {
                    query: keyword,
                    limit: 20
                });
                
                const container = document.getElementById('filter-result-list');
                const resultsCard = document.getElementById('filter-results');

                if (!data.results || data.results.length === 0) {
                    container.innerHTML = `
                        <div class="empty-state">
                            <div class="icon">🔍</div>
                            <p>没有找到符合条件的记忆</p>
                        </div>
                    `;
                } else {
                    container.innerHTML = data.results.map(result => {
                        const html = renderMemoryItem(result);
                        const similarityPercent = (result.similarity * 100).toFixed(1);
                        return html.replace('<div class="content">', `<div class="content"><small style="color: #667eea;">相关度：${similarityPercent}%</small><br>`);
                    }).join('');
                }

                resultsCard.style.display = 'block';
            } catch (error) {
                showToast('筛选失败：' + error.message, 'error');
            }
        }

        // Clear Filters
        function clearFilters() {
            document.getElementById('filter-time').value = '';
            document.getElementById('filter-start-date').value = '';
            document.getElementById('filter-end-date').value = '';
            document.getElementById('filter-location').value = '';
            document.getElementById('filter-person').value = '';
            document.getElementById('filter-tags').value = '';
            document.getElementById('filter-keyword-adv').value = '';
            document.getElementById('filter-results').style.display = 'none';
            showToast('已清空筛选条件', 'info');
        }

        // Close modal on outside click
        document.getElementById('modal-detail').addEventListener('click', (e) => {
            if (e.target === document.getElementById('modal-detail')) {
                closeModal();
            }
        });

        // Keyboard shortcuts
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeModal();
            }
        });

        // Enable custom date inputs when "custom" is selected
        document.getElementById('filter-time')?.addEventListener('change', (e) => {
            const startDate = document.getElementById('filter-start-date');
            const endDate = document.getElementById('filter-end-date');
            if (e.target.value === 'custom') {
                startDate.disabled = false;
                endDate.disabled = false;
            } else {
                startDate.disabled = true;
                endDate.disabled = true;
            }
        });
    </script>
</body>
</html>
