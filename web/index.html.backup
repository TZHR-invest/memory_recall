                        </div>
                    `;
                } else {
                    container.innerHTML = data.results.map(memory => renderMemoryItem(memory)).join('');
                }

                resultsCard.style.display = 'block';
            } catch (error) {
                showToast('搜索失败：' + error.message, 'error');
            }
        }

        async function searchByPerson() {
            const person = document.getElementById('filter-person').value.trim();
            
            if (!person) {
                showToast('请输入人物名称', 'error');
                return;
            }

