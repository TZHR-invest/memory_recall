# Memory Recall - 环境变量配置示例

# 数据库配置
DATABASE_URL=postgresql://postgres:password@localhost:5432/memory_recall
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=memory_recall
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# 火山引擎 API 配置
VOLC_API_KEY=your_api_key_here
VOLC_API_BASE=https://ark.cn-beijing.volces.com/api/v3
VOLC_LLM_MODEL=doubao-seed-2-0-pro-260215
VOLC_EMBEDDING_MODEL=doubao-embedding-vision-251215

# 文件存储
STORAGE_PATH=/data/storage

# 应用配置
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
