{
  "name": "memory-recall-opencode",
  "version": "1.2.1",
  "description": "Memory Recall plugin for OpenCode - persistent memory across sessions",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "memory-recall-opencode": "./dist/cli.js"
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "chat.message",
      "event",
      "experimental.session.compacting"
    ]
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --external @opencode-ai/plugin --external @opencode-ai/sdk && bun build ./src/cli.ts --outfile ./dist/cli.js --target node",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.3.0",
    "@opencode-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.3.0",
    "@opencode-ai/sdk": "^1.3.0",
    "typescript": "^5.4.0",
    "@types/bun": "latest"
  },
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "ai",
    "context",
    "recall"
  ],
  "license": "MIT"
}
