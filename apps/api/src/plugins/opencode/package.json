{
  "name": "memory-recall-opencode",
  "version": "1.0.0",
  "description": "Memory Recall plugin for OpenCode - persistent memory across sessions",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --external @opencode-ai/plugin --external @opencode-ai/sdk",
    "dev": "bun build ./src/index.ts --outdir ./dist --target bun --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.3.0",
    "@opencode-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.3.0",
    "@opencode-ai/sdk": "^1.3.0",
    "typescript": "^5.4.0",
    "@types/bun": "latest"
  },
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "ai",
    "context"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ohmyopencode/memory-recall"
  }
}
