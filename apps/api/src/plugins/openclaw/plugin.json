{
    "id": "memory-recall",
    "kind": "memory",
    "configSchema": {
        "type": "object",
        "properties": {
            "apiKey": {
                "type": "string",
                "description": "API key for authentication"
            },
            "baseUrl": {
                "type": "string",
                "default": "http://localhost:8000",
                "description": "Memory Recall API base URL"
            },
            "containerTag": {
                "type": "string",
                "default": "openclaw_default",
                "description": "Memory namespace container tag"
            },
            "autoRecall": {
                "type": "boolean",
                "default": true,
                "description": "Auto-inject memories before AI turn"
            },
            "autoCapture": {
                "type": "boolean",
                "default": true,
                "description": "Auto-store conversations after turn"
            },
            "maxRecallResults": {
                "type": "number",
                "default": 10,
                "minimum": 1,
                "maximum": 50,
                "description": "Max memories injected per turn"
            }
        }
    },
    "uiHints": {
        "apiKey": {
            "label": "API Key",
            "sensitive": true,
            "placeholder": "your-api-key",
            "help": "API key for Memory Recall authentication"
        },
        "baseUrl": {
            "label": "API Base URL",
            "placeholder": "http://localhost:8000",
            "help": "Memory Recall API server URL"
        },
        "containerTag": {
            "label": "Container Tag",
            "placeholder": "openclaw_default",
            "help": "Memory namespace for isolation"
        },
        "autoRecall": {
            "label": "Auto-Recall",
            "help": "Inject relevant memories before every AI turn"
        },
        "autoCapture": {
            "label": "Auto-Capture",
            "help": "Automatically store conversations"
        },
        "maxRecallResults": {
            "label": "Max Recall Results",
            "placeholder": "10",
            "help": "Maximum memories injected per turn"
        }
    }
}
