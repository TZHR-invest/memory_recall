# Memory Recall - 环境变量配置示例

# 数据库配置
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/memory_recall
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=memory_recall
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password

# LLM 提供商：volcengine（豆包）/ deepseek（官方直连）/ opencodex（commandcode 聚合，本机代理）
LLM_PROVIDER=volcengine

# 火山引擎 API 配置（LLM + Embedding 共用，Embedding 始终走火山）
VOLC_API_KEY=your_api_key_here
VOLC_API_BASE=https://ark.cn-beijing.volces.com/api/v3
VOLC_LLM_MODEL=doubao-seed-2-0-mini-260215
VOLC_EMBEDDING_MODEL=doubao-embedding-vision-251215

# DeepSeek LLM 配置（LLM_PROVIDER=deepseek 时生效）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_LLM_MODEL=deepseek-v4-flash

# OpenCodeX 代理 LLM 配置（LLM_PROVIDER=opencodex 时生效；模型 id 为斜杠形态，需 key）
# ⚠️ 容器内必须填局域网 IP/宿主地址（127.0.0.1 是容器自身）
OPENCODEX_API_KEY=your_opencodex_api_key_here
OPENCODEX_API_BASE=http://192.168.0.206:10100/v1
OPENCODEX_LLM_MODEL=commandcode/deepseek/deepseek-v4.1-flash

# 文件存储
STORAGE_PATH=./storage

# 应用配置
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Function Calling 配置
USE_FUNCTION_CALLING=true

# Recall Trace 配置（召回链路可观测性）
TRACE_ENABLED=true
TRACE_SAMPLE_RATE=1.0
TRACE_RETENTION_DAYS=7
TRACE_CONTENT_MAX_LEN=200
